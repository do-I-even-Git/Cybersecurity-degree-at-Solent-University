#include <stdio.h>

int main(void) {

    //Set of int variables are printed to store user inputs on check date and event date.
    int days = 0;
    int month = 0;
    int eventDays = 0;
    int eventMonth = 0;

    //Instruction is printed and input is obtained and stored into corresponding variables.
    printf("You can now input a day and month value, please use numeric values.\n\n");
    printf("Please input your DAY now: ");
    scanf("%d", &days);
    printf("\nPlease input your MONTH now: ");
    scanf("%d", &month);
    //Math concatenation converts month input into equivalent day value, adds to day input, and stores in variable.
    int monthconver = ((month * 30) - 30) + days;
    printf("\nPlease input your EVENT DAY now: ");
    scanf("%d", &eventDays);
    printf("\nPlease input your EVENT MONTH now: ");
    scanf("%d", &eventMonth);
    int eventmonthconver = ((eventMonth * 30) - 30) + eventDays; //Maths repeat for event date.

    //Total days variables are sustracted to find days difference between.
    int daysDiff = (eventmonthconver - monthconver);

    //if statement check if checking date is before event date, if so, prints days difference between them.
    if (eventmonthconver > monthconver) {
        printf("\n\nThere are aprox. %d days left until the event date. :)", daysDiff);
    } else if (eventmonthconver < monthconver) { //else if displays error message otherwise
        printf("\n----------System error----------\n The introduced event date takes place before today.");
        printf("\n\n----------Please try again.----------");
    }

    return 0;
}
