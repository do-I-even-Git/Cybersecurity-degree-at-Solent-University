#include <stdio.h>
#include <string.h>
///////cambio de nombre al Item.txt, a las sesiones de FILE *, quitado break de Case 3.
//ALL GRADE D COMMENTARY IS DELETED FOR READABILITY AND TASK REPORT CLARITY PURPOSES.

struct Item {
    int id;
    char assetTag[99];
    char status[3];
};

//Parameters are added to addItem. Two more functions are declared for searching by ID and duplicate checking.
void addItem(int id, char assetTag[], char status[]);
void displayItems(void);
void searchItemById(int id);

int main(void) {
    int choice;

    do {
        printf("\n  ===== Welcome to the Stock Manager =====  ");
        printf("\n  - What would you like to do today? :) -");
        printf("\nPlease use the indicated number for your chosen action.");
        printf("\n1. Add new item.");
        printf("\n2. Display all items.");
        printf("\n3. Search item using ID."); //ID search option is added.
        printf("\n4. Finish the session.\n");
        scanf("%d", &choice);
        getchar();

        switch (choice) {
            case 1: {
                //Variables are moved into case 1 to abilitate obtention logic within main function.
                int id;
                char assetTag[99];
                char status[3];



                //Appending value obtention logic is moved into int main.
                printf("\n --- Enter id to assign on file: \nUse only integer values.\n");
                scanf("%d", &id);
                getchar();

                printf("\n --- Enter assetTag to assign on file: \nUse AAAAA-000 format.\n");
                fgets(assetTag, sizeof(assetTag), stdin);
                assetTag[strcspn(assetTag, "\n")] = 0;

                printf("\n --- Enter status to assign on file: \nUse A - Available / U - In use / L - Lost / R - Needing repair\n");
                fgets(status, sizeof(status), stdin);
                status[strcspn(status, "\n")] = 0;


                //Recalling function to execute appending into file.
                addItem(id, assetTag, status);
            }
            break;
            case 2:

                displayItems();

            break;
            case 3: {  //Declaring a new case for ID search, placing it before the exit case.


                //Declaring a new variable to store user input and be utilized by the new searchItemById function.
                int searchId;
                printf("\n You have chosen 3. Search item using ID."); //Printing choice confirmation.
                printf("\nEnter the ID you'd like to search now. "); //Demanding user input.
                scanf("%d", &searchId); //Scanning input, storing in search variable.
                getchar(); //Buffer clean

                searchItemById(searchId); //Running variable as search function's condition.
            }
            break;
            case 4:

                printf("\nFinishing your session now...");
                printf("\n.\n..\n...Thanks come again! :)");

            return 0;
            default:

                printf("\n ===== ERROR ====== ERROR ====== \nPlease pick a number corresponding to an option above.");

            break;
        }
    } while (choice != 4);
}

//Adding parameters to addItem.
void addItem(int id, char assetTag[], char status[]) {
    struct Item appendItem;
    int isDuplicate = 0; //Declaring a binary flag in indicate ID duplicate match, initialized to binary false value.

//CHECK BLOCK
//Opening file in a different action for ID duplication check.
    FILE *idCheck = fopen ("logReg.txt", "r");
    
    //Succesful opening: Reads the register with Grade D logic.
    if (idCheck != NULL) {
        while (fscanf(idCheck, "%d --- %98s --- %2s\n", &appendItem.id, appendItem.assetTag, appendItem.status) == 3) {
            if (appendItem.id == id) { //Compares input ID with existant IDs. If matching: duplicate binary flag turns on.
                isDuplicate = 1;
            break;
            }
        }
        fclose(idCheck); //File is safely closed, menu restarted.
    }
    if (isDuplicate) {
        printf(" === ERROR === \nItem with ID %d already exists in the register. \nEntry aborted.\n", id);
    return;
    }
//If not duplicated, appending occurs normally.
//APPEND BLOCK
    FILE *appendReg = fopen("logReg.txt", "a");
        if ( appendReg == NULL) {
            printf("Error opening file! Case: APPENDING SESSION\n");
            return;
        }
        fprintf(appendReg, "%d --- %s --- %s\n", id, assetTag, status);
    fclose(appendReg);
    printf("Input content appended to file successfully.\n");
}


//DISPLAY BLOCK
void displayItems(void) {
    struct Item readItem;
    FILE * readReg = fopen("logReg.txt", "r");

    if ( readReg == NULL) {
        printf("Error opening file! Case: READING SESSION\n");
        return;
    }

    printf("=== STOCK MANAGEMENT RECORDS ===");

    while (fscanf( readReg, "%d --- %98s --- %2s\n", &readItem.id, readItem.assetTag, readItem.status) == 3) {
        printf("\nID: %d --- Asset Tag: %s --- Status: %s\n", readItem.id, readItem.assetTag, readItem.status);
    }

    fclose( readReg);
}

//SEARCH BLOCK
//Declaring new search by ID function, passing input id integer as parameter to it's condition.
void searchItemById(int searchId) {
//Declaring local search item.
    struct Item searchItem;
    int isFound = 0; //Declaring binary flag variable, same as previous.
//Reading the file under searchReg.
    FILE *searchReg = fopen("logReg.txt", "r");

//Local opening error check and alert.
    if (searchReg == NULL) {
        printf("Error opening file! Case: SEARCH SESSION");
        return;
    }

//Checking id match using the same logic as duplicate checking above.
    while (fscanf(searchReg, "%d --- %98s --- %2s\n", &searchItem.id, searchItem.assetTag, searchItem.status) == 3){
        if (searchItem.id == searchId) {
            isFound = 1;
            break;
        }
    }
//Closing safely searchReg session.
    fclose(searchReg);

    if (isFound) {
        printf("\n=== RECORD FOUND ==="); //If duplicate is found, confirmation and registry are displayed.
        printf("\nID: %d --- Asset Tag: %s --- Status: %s", searchItem.id, searchItem.assetTag, searchItem.status);
    } else {
        printf("\nNo records matches ID %d", searchId);
    }

}//END OF PROGRAM
