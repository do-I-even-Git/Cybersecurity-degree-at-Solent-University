    if ( readReg == NULL) {
        printf("Error opening file! Case: READING SESSION\n");
        return;
    }

    printf("=== STOCK MANAGEMENT RECORDS ===");

    while (fscanf( readReg, "%d --- %98s --- %2s\n", &readItem.id, readItem.assetTag, readItem.status) == 3) {
        printf("\nID: %d --- Asset Tag: %s --- Status: %s\n", readItem.id, readItem.assetTag, readItem.status);
    }

    fclose( readReg);
}// END OF DISPLAY BLOCK

// SEARCH BLOCK
int searchItemById(int searchId) {
    struct Item searchItem;
    int isFound = 0;
    int revCount = 0; //Declaring an int var that will store line position of found record.
    FILE *searchReg = fopen("logReg.txt", "r");

    if (searchReg == NULL) {
        printf("Error opening file! Case: SEARCH SESSION");
        return 33; //Implementing coded return where allowed.
    }

    while (fscanf(searchReg, "%d --- %98s --- %2s\n", &searchItem.id, searchItem.assetTag, searchItem.status) == 3){
        revCount++; //By adding 1 per line read, we obtain a line count until the below if finds match and breaks while.
        if (searchItem.id == searchId) {
            isFound = 1;
            break;
        }
    }
    fclose(searchReg);

    if (isFound) {
        printf("\n=== RECORD FOUND ===");
        printf("\nID: %d --- Asset Tag: %s --- Status: %s", searchItem.id, searchItem.assetTag, searchItem.status);
        printf("\n=== Registry line: ");//Printing an indicator that the next number is the matching line position.
        return revCount; //Returning coded to use the while iteration count when matching ID was found, reclecting position.
    }
    if (!isFound) {
        printf("\n=== No records matches ID %d. ===", searchId);
        return -1; //Returning with code specified as per Grade B.
    }
} // END OF SEARCH BLOCK

// UPDATE BLOCK
int updateItem(int id, const char newAssetTag[], const char newStatus[]){ //Declaring new function as per Grade B spec.
    struct Item updateItem[fullRecord]; //Declaring temporary array to contain reg copy during operation.
    int copyCount = 0; //Declaring variable to hold line count during copying.
    int regNum = -1; //Declaring variable to hold ID match line number, preset to flag in case of operation failure.

    FILE *copyReg = fopen ("logReg.txt", "r"); //Opening new session for reg copy purpose.
//Checking for copy session opening failure with coded return.
    if (copyReg == NULL) {
        printf("Error opening file! Case: COPY SESSION\n");
        return 44;
    }
//Declaring while to iterate record, conditioned to defined element length and fscanf copying into temporary variables)
    while (copyCount < fullRecord && fscanf(copyReg, "%d --- %98s --- %2s\n",
    &updateItem[copyCount].id, updateItem[copyCount].assetTag, updateItem[copyCount].status) == 3) {
        if (updateItem[copyCount].id == id) { //Declaring if statement where copyCount stores registry number if ID matches.
            regNum = copyCount;
        }
        copyCount++;//Assigning copyCount to keep iteration number as this corresponds to registry line.
    }
    fclose(copyReg); //Closing reading session safely.

    //Declaring if statement to check if ID was failed, if so, failure message is printed and code 0 return actioned.
    if (regNum == -1) {
        printf("\nInput content updated to file failed! ID is not found!\n");
        return 0;
    }

//Utilizing strncpy to overwrite with newAssetTag in the line where ID matched. Length is -1 to keep space for line cut.
    strncpy(updateItem[regNum].assetTag, newAssetTag, sizeof(updateItem[regNum].assetTag) - 1);
        updateItem[regNum].assetTag[sizeof(updateItem[regNum].assetTag) - 1] = '\0'; //Assigning said line cut.

//The same code is recycled to work over the Status field.
    strncpy(updateItem[regNum].status, newStatus, sizeof(updateItem[regNum].status) - 1);
        updateItem[regNum].status[sizeof(updateItem[regNum].status) - 1] = '\0';

//Opening file a second time to rewrite the registry with the corrected Asset Tag and Status.
    FILE *rewriteReg = fopen ("logReg.txt", "w");
        if (rewriteReg == NULL) { //Implementing opening success check.
            printf("Error opening file! Case: REWRITE SESSION\n");
            return 55; //Unique code return.
        }

//Utilizing a for loop to iterate the file, copyCount iterated the whole file and guarantees same entry count.
        for (int i = 0; i < copyCount; i++) {

//Utilizing fprintf to write in rewriteReg every line of code respecting format, extracting from the temporary variable.
            fprintf(rewriteReg, "%d --- %s --- %s\n", updateItem[i].id, updateItem[i].assetTag, updateItem[i].status);
        }
    fclose(rewriteReg);//Closing rewrite session safely.

//Printing at the end of execution a confirmation message to user.
        printf("\nInput content updated to file succesfully!\n");
        return 1; //return is coded to 1 by Grade B requirements.

}// END OF UPDATE BLOCK
