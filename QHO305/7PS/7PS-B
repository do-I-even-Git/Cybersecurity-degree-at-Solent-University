int addItem(int id, char assetTag[], char status[]) {
    struct Item appendItem;
    int isDuplicate = 0;

// CHECK BLOCK
    FILE *idCheck = fopen ("logReg.txt", "r");
    if (idCheck == NULL) {
        printf("Error opening file! Case: ID-CHECK SESSION\n");
        printf("Be advised: ID check did not take place!!\n");
        printf("Ignore if this is the first entry into empty registry.\n");
    }
    if (idCheck != NULL) {
        while (fscanf(idCheck, "%d --- %98s --- %2s\n", &appendItem.id, appendItem.assetTag, appendItem.status) == 3) {
            if (appendItem.id == id) {
                isDuplicate = 1;
            break;
            }
        }
        fclose(idCheck);
    }// END OF CHECK BLOCK


    if (isDuplicate) {
        printf(" === ERROR === \nItem with ID %d already exists in the register. \nEntry aborted.\n", id);
    return 0;
    }
// APPEND BLOCK
    FILE *appendReg = fopen("logReg.txt", "a");
        if ( appendReg == NULL) {
            printf("Error opening file! Case: APPENDING SESSION\n");
            return 11; //Implementing coded return where allowed.
        }
        fprintf(appendReg, "%d --- %s --- %s\n", id, assetTag, status);
    fclose(appendReg);
    printf("Input content appended to file successfully.\n");
    return 1;
}// END OF APPEND BLOCK


// DISPLAY BLOCK
void displayItems(void) {
